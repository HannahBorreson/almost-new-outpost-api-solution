{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "almost-new-outpost-api",
    "Audience": "almost-new-outpost-ui",
    "ExpiryMinutes": 60
  },
  "Weather": {
    "Provider": "Random",
    "RefreshMinutes": 5,
    "Weights": {
      "Clear": 55,
      "Storm": 15,
      "DustStorm": 15,
      "RadiationEvent": 15
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
