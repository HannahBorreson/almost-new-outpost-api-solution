<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AlmostNewOutpost.Api</RootNamespace>
    <!-- Secrets (connection string, JWT signing key) live in user-secrets, never in appsettings.json. -->
    <UserSecretsId>almost-new-outpost-api-3f6b2c1e</UserSecretsId>
  </PropertyGroup>

  <!--
    PasswordHasher<T> comes from Microsoft.Extensions.Identity.Core, which is already part of the
    ASP.NET Core shared framework, so it needs no PackageReference here (adding one triggers
    warning NU1510 on .NET 10). Microsoft.IdentityModel.JsonWebTokens comes in with JwtBearer.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

</Project>
